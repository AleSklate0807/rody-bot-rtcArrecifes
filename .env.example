# ============================================================
# RODY BOT — Variables de entorno
# ----------------------------------------------------------
# Telegram
# ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=.................

# Cadena aleatoria que usás para validar que los requests
# vienen de Telegram y no de otra fuente.
# Generala con: python -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=................

# ----------------------------------------------------------
# Supabase
# Lo encontrás en: Supabase Dashboard > Project Settings > API
# ----------------------------------------------------------
SUPABASE_URL=..........
SUPABASE_SERVICE_KEY=......................

# ----------------------------------------------------------
# Google AI Studio
# Obtenelo en: https://aistudio.google.com/app/apikey
# ----------------------------------------------------------
GEMINI_API_KEY=...................................
# Modelo a usar (ver modelos disponibles en AI Studio)
GEMINI_MODEL=gemini-3.5-flash

# ----------------------------------------------------------
# Control de acceso
# ----------------------------------------------------------
# Tu ID de Telegram (y el de otros admins), separados por coma.
# Lo podés obtener escribiéndole a @userinfobot en Telegram.
ADMIN_TELEGRAM_IDS=

# true = cualquiera que escriba queda habilitado sin aprobación
ACCESO_ABIERTO=false
# ----------------------------------------------------------
# Configuración del bot
# ----------------------------------------------------------
BOT_ENVIRONMENT=production
LOG_LEVEL=INFO

